# pick a cell and find its spike times
cell_ind = 30
cell_spike_binary = spike_binary[cell_ind, :]
cell_spike_times = np.where(cell_spike_binary)[0]
cell_spike_times.shape

# define a window size
window_size = 25 # frames

# Loop over all the cell's spike times
#     For each spike time, find the snippet start and stop time (stop time = spike time)
#     use the window start and stop times to index into the stimulus and pull out the snippet leading to that spike
#     check to make sure that snippet length == window_size
#     append the spike-triggered stimulus to a growing list
# compute the average of the spike triggered ensemble

spike_triggered_ensemble = []
for spike_time in cell_spike_times:
    start_frame = spike_time - window_size
    end_frame = spike_time
    stimulus_before_spike = stimulus_contrast [start_frame:end_frame]
    if len(stimulus_before_spike) == window_size:
        spike_triggered_ensemble.append(stimulus_before_spike)

spike_triggered_ensemble = np.vstack(spike_triggered_ensemble)
spike_triggered_ensemble.shape


spike_triggered_average = np.mean(spike_triggered_ensemble, axis=0)
plt.plot(spike_triggered_average)















