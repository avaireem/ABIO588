sns.kdeplot(data=spots_df, x="x", y="y", fill=True, cmap="magma", cbar=True)
plt.gca().invert_yaxis()
plt.gca().set_aspect("equal")
plt.savefig(r"/Users/avaireemcconnell/Documents/GitHub/ABIO588/mrna_kde.png")
plt.show()
# Brightest/Hottest color (yellow)= mRNA hotspots where they're packed close together
# Medium colors (purple/red)= steady spread of individual cytoplasmic mRNA
# Darkest= very few or zero mRNA particles


counts_table = spots_df["type"].value_counts().reset_index()
