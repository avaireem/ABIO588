img_float = img_as_float(img01_cells)
spots = blob_log(img_float, min_sigma=1, max_sigma=3, threshold=0.001)
print(f"Total Unique Particles Isolated: {len(spots)}")


print(sns.get_dataset_names())


img_2d = img01_cells
img_display = img_2d.astype(float)
fig, ax = plt.subplots(figsize=(10, 10))
