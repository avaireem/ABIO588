for spot in spots:
    y, x, r = spot
    circle = plt.Circle((x, y), radius=4, color='red', fill=False, linewidth=0.8)
    ax.add_patch(circle)
ax.set_title(f"Verified Visuals: {len(spots)} Detected Particles")
ax.axis('on')
plt.savefig(r"/Users/avaireemcconnell/Documents/GitHub/ABIO588/verified_mrna_visual.png", dpi=300)
