fh, ax = plt.subplots(1, 1, figsize=(6, 3))
sns.stripplot(data=spots_df, y="sigma", color="teal", size=3, alpha=0.6, jitter=0.2, ax=ax)
plt.title("Distribution of Individual mRNA Particle Sizes")
plt.ylabel("Spot Sigma (pixels)")
plt.savefig(r"/Users/avaireemcconnell/Documents/GitHub/ABIO588/mrna_size_distr.png")
plt.show()
# Tight, dark band of the overlapping dots tells us that the found mRNA particles are the same physical size
# sign that the detectin of the single-molecule mRNAs are true

# The dots above the bands (outliers) are the abnormally large spots that are often either active transcription sites
# or overlapping transcripts

# The darkest areas (where many dots overlap)= mode (most common value)


spots_df["type"] = np.where(spots_df["sigma"] > 2.0, "Outlier", "Single mRNA")
sns.scatterplot(data=spots_df, x="x", y="y", hue="type", palette={"Single mRNA": "teal", "Outlier": "red"})
plt.gca().invert_yaxis()
plt.gca().set_aspect("equal")
plt.savefig(r"/Users/avaireemcconnell/Documents/GitHub/ABIO588/true_vs_outlier_mrna.png")
