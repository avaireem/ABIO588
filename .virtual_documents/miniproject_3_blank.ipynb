# The educational way
# Get the unique labels
labels = np.unique(label_img)[1:]
labels

# Loop over the labels
#     Find the mask for that label
#     Compute: area(num. pixels) and mean intensity of labeled area
#     Append area and intensity to growing list

areas = []
intensities = []
for this_label in labels:
    cell_mask = label_img == this_label
    area = np.sum(cell_mask)
    intensity = np.mean(img_cells[cell_mask])

    areas.append(area)
    intensities.append(intensity)

num_cells = len(areas)
print(num_cells)
print(areas)
print(intensities)


# The easy way:
region_properties = measure.regionprops(label_img, intensity_image=img_cells)
num_cells = len(region_properties)

region_properties[0].intensity_mean

areas = [x.area for x in region_properties]
intensities = [x.intensity_mean for x in region_properties]

print(num_cells)
print(areas)
print(intensities)





def measure_cells(input_image, show_segmentation=False):
    """ 
        measure_cells(input_image)
            Using automatic thresholding to identify and quantify cell properties from fluor images
        
        args
            input_image: 2 dimensional ndarray
        returns
            intensity - list
            area - list
    """
    # compute threshold from image using Li's method
    thresh = filters.threshold_li(input_image)
    

    # make binary mask -- same size as image, BUT it's boolean(true/false)/binary(0/1)
    mask = input_image > thresh
   

    # using mask, ID the labels (components)
    label_image = measure.label(mask)
   

    # Measure area and intensity of each label component
    # e.g. using regionprops OR full for loop
    region_properties = measure.regionprops(label_image, intensity_image=input_image)
    
    areas = [x.area for x in region_properties]
    intensities = [x.intensity_mean for x in region_properties]

    if show_segmentation:
        fh, ax = plt.subplots(1, 3, figsize=(12, 4))
        ax[0].imshow(input_image, cmap='gray')
        ax[1].imshow(mask, cmap='gray')
        ax[2].imshow(label_image, cmap='tab20')
        
    return areas, intensities





a = imread(filename)
area, intensities = measure_cells(a, show_segmentation=True)
print(areas)
print(intensities)











import glob
batch_data_dir = 'images'
filepaths = glob.glob(os.path.join(batch_data_dir, '*.tif'))

print(len(filepaths))
print(filepaths[0])


areas = []
intensities = []
n_cells = []
for current_filepath in filepaths:
    img_cells = imread(current_filepath)
    img_areas, img_intensities = measure_cells(img_cells, show_segmentation=True)

    areas.append(img_areas)
    intensities.append(img_intensities)
    n_cells.append(len(img_areas))


len(areas)


fh, ax = plt.subplots(1, 1, figsize=(6, 3))
sns.violinplot(intensities, ax=ax)
ax.set_ylabel('Cell Intensity')
ax.set_xlabel('Image')



