import numpy as np
import matplotlib.pyplot as plt
import os
import seaborn as sns
from skimage import filters, measure
from skimage.io import imread





filename = 'xy_8bit_mitocheck.tif'
img_cells = imread(filename)





print(type(img_cells))
print(img_cells.shape)





plt.imshow(img_cells)
plt.axis('off')
plt.show()


fh, ax = plt.subplots(1, 1, figsize=(4, 4))
ax.imshow(img_cells, cmap='gray')





fh, ax = plt.subplots(1, 1, figsize=(4, 4))
ax.imshow(img_cells[225:275, 100:150], cmap='gray')





img_cells.shape
# rows and columns


img_cells.flatten().shape
# makes 2D img into 1D
# this is the x


fh, ax = plt.subplots(1, 1, figsize=(4, 3))
ax.hist(img_cells.flatten(), bins=50)
ax.set_xlabel('Pixel intensities')
ax.set_ylabel('Count')
ax.set_yscale('log')
# to make logmerithmic instead of linear scale





# Find the threshold intensity value - values higher than this are included, and lower are excluded
thresh = filters.threshold_li(img_cells)
print(thresh)

# Apply the threshold to return a binary mask
# Mask = ndarray, same size as the image. All the values should be True/False 
mask = img_cells > thresh
print(mask.shape)
print(np.unique(mask))

# Look at the threshold that is computed and compare to the distribution of pixel values 
fh, ax = plt.subplots(1, 1, figsize=(4, 3))
ax.hist(img_cells.flatten(), bins=50)
ax.axvline(thresh, color='k')
ax.set_yscale('log')

# View the mask alongside the original image 
fh, ax = plt.subplots(1, 2, figsize=(8,4))
# the two numbers after subplots = rows, columns
ax[0].imshow(img_cells, cmap='gray')
ax[1].imshow(mask, cmap='gray')


filters.try_all_threshold(img_cells)
# goes through all possible types of threshold to make finding right one easier








label_img = measure.label(mask)
print(label_img.shape)
print(np.unique(label_img))





fh, ax = plt.subplots(1, 3, figsize=(12, 4))
ax[0].imshow(img_cells, cmap='gray')
ax[1].imshow(mask, cmap='gray')
ax[2].imshow(label_img, cmap='tab20')





